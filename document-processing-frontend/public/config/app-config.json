{
  "version": 1,
  "app": { "name": "Analyse documentaire", "defaultLocale": "fr" },
  "mock": { "enabled": true, "scenario": "happy-path" },
  "features": { "chatEnabled": true, "showConfidence": true },
  "polling": { "intervalMs": 350, "maxIntervalMs": 2000, "maxDurationMs": 300000, "concurrency": 4 },
  "taskStatus": {
    "queued": ["queued", "pending", "PENDING"],
    "running": ["running", "started", "STARTED", "in_progress"],
    "succeeded": ["succeeded", "success", "SUCCESS", "completed"],
    "failed": ["failed", "failure", "FAILURE", "error"],
    "cancelled": ["cancelled", "revoked", "REVOKED"]
  },
  "backends": {
    "source": {
      "basePath": "/backend/source",
      "routes": {
        "gedContracts": { "method": "GET", "path": "/v1/ged/contracts" },
        "startIntake": { "method": "POST", "path": "/v1/intakes" },
        "getTask": { "method": "GET", "path": "/v1/tasks/{taskId}" }
      }
    },
    "catalog": {
      "basePath": "/backend/catalog",
      "routes": {
        "listContractsWithDocuments": { "method": "GET", "path": "/v1/workflows/{workflowId}/contracts" },
        "getPdf": { "method": "GET", "path": "/v1/workflows/{workflowId}/documents/{documentId}/content" }
      }
    },
    "processing": {
      "basePath": "/backend/processing",
      "routes": {
        "startProcessing": { "method": "POST", "path": "/v1/workflows/{workflowId}/processing-jobs" },
        "getTask": { "method": "GET", "path": "/v1/tasks/{taskId}" },
        "getTaskResults": { "method": "GET", "path": "/v1/tasks/{taskId}/results" }
      }
    },
    "chat": {
      "basePath": "/backend/chat",
      "routes": { "ask": { "method": "POST", "path": "/v1/chat" } }
    }
  }
}
